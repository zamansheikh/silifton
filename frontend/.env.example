# Base URL of the API that serves site content, the contact/careers forms and
# the analytics beacon. This is the CRM API (silifton-crm/backend).
NEXT_PUBLIC_API_URL=https://crmapi.silifton.com

# Canonical site origin used for SEO (canonical URLs, sitemap, Open Graph, robots).
# No trailing slash. Defaults to https://silifton.com if unset.
NEXT_PUBLIC_SITE_URL=https://silifton.com

# Where /admin and /login redirect (content is edited in the CRM).
NEXT_PUBLIC_CRM_URL=https://crm.silifton.com

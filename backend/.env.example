# =============================================================
# Silifton — backend environment template
# Copy to `.env` and fill in the blanks.
# =============================================================

# --- HTTP server ---
PORT=7001
CORS_ORIGIN=http://localhost:7000

# --- MongoDB ---
MONGODB_URI=
MONGODB_DB=silifton

# --- Admin account (seeded on first boot) ---
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Admin

# --- JWT ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# --- Resend (optional — emails on new inquiry) ---
RESEND_API_KEY=
CONTACT_EMAIL=
FROM_EMAIL=Silifton <hello@silifton.com>

# --- Cloudinary (image uploads) ---
# Format: cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=
CLOUDINARY_FOLDER=silifton
UPLOAD_MAX_BYTES=10485760
